#!/bin/bash
#------------------------------------------------------------------------------
# Heated pipe flow: blockMesh -> checkMesh -> buoyantSimpleFoam
#------------------------------------------------------------------------------
cd "${0%/*}" || exit 1

. "${WM_PROJECT_DIR:?}/bin/tools/RunFunctions"

runApplication blockMesh
runApplication checkMesh
runApplication buoyantSimpleFoam

# runApplication does not stop on failure, so check that the solver finished.
if ! grep -q "^End" log.buoyantSimpleFoam
then
    echo "buoyantSimpleFoam did not finish normally, see log.buoyantSimpleFoam" >&2
    exit 1
fi

if grep -q "SIMPLE solution converged" log.buoyantSimpleFoam
then
    grep "SIMPLE solution converged" log.buoyantSimpleFoam
else
    echo "Warning: residual criteria not met within endTime"
fi
echo "Done. View the results with ./open_paraview.sh"
