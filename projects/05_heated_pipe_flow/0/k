FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      k;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -2 0 0 0 0];

// Inlet turbulence intensity 5 %: k = 1.5 (0.05 * 0.5 m/s)^2
internalField   uniform 9.4e-4;

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform 9.4e-4;
    }

    outlet
    {
        type            zeroGradient;
    }

    topWall
    {
        type            kqRWallFunction;
        value           uniform 9.4e-4;
    }

    bottomWall
    {
        type            kqRWallFunction;
        value           uniform 9.4e-4;
    }

    frontAndBack
    {
        type            empty;
    }
}

