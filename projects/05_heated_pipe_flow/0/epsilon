FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      epsilon;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -3 0 0 0 0];

// epsilon = Cmu^0.75 k^1.5 / l with l = 0.07 D_h = 0.014 m (D_h = 2H)
internalField   uniform 3.4e-4;

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform 3.4e-4;
    }

    outlet
    {
        type            zeroGradient;
    }

    topWall
    {
        type            epsilonWallFunction;
        value           uniform 3.4e-4;
    }

    bottomWall
    {
        type            epsilonWallFunction;
        value           uniform 3.4e-4;
    }

    frontAndBack
    {
        type            empty;
    }
}

