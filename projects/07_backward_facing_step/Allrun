#!/bin/bash
#------------------------------------------------------------------------------
# Allrun - backward-facing step (simpleFoam, steady, k-omega SST)
#   blockMesh -> checkMesh -> simpleFoam -> near-wall velocity sample
# Each step writes log.<application>; the script stops at the first failure.
#------------------------------------------------------------------------------
cd "${0%/*}" || exit 1

# Source OpenFOAM run functions
. "${WM_PROJECT_DIR:?OpenFOAM environment not sourced}/bin/tools/RunFunctions"

run() {
    runApplication "$@" || { echo "ERROR: $1 failed, see log.$1" >&2; exit 1; }
}

run blockMesh
run checkMesh
run simpleFoam
# Ux along a line in the first cell row above bottomWall (used by verify.py)
runApplication -s nearWall postProcess -func sampleDict -latestTime \
    || { echo "ERROR: postProcess failed, see log.postProcess.nearWall" >&2; exit 1; }

echo "Case complete. Check results with: python3 verify.py"
echo "View results with: ./open_paraview.sh"

#------------------------------------------------------------------------------
