FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      sampleDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Used with: postProcess -func sampleDict -latestTime
// Mean streamwise velocity UMean in the first cell row above the floor
// (floor at y = 0, first cell 0.06 mm high), from the step to the outlet.
// verify.py finds the mean reattachment point where UMean_x turns positive.

type            sets;
libs            ("libsampling.so");

interpolationScheme cell;

setFormat       raw;

fields          (UMean);

sets
(
    floor
    {
        type        lineUniform;
        axis        x;
        start       (0.0001 0.00003 0);
        end         (0.2499 0.00003 0);
        nPoints     2500;
    }
);

