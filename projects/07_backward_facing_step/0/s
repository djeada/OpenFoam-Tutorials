FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      s;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 0 0 0 0];

// Passive dye (scalarTransport function object in system/controlDict).
// It enters in the inlet boundary layer, the lowest 0.6h of the inlet, so it
// marks the fluid that separates at the step lip and rolls up in the shear layer.
internalField   uniform 0;

boundaryField
{
    inlet
    {
        type            fixedProfile;
        profile         table
        (
            (0       1)
            (0.0059  1)
            (0.0061  0)
            (0.05    0)
        );
        direction       (0 1 0);
        origin          0.01;
        value           uniform 0;
    }

    outlet
    {
        type            inletOutlet;
        inletValue      uniform 0;
        value           uniform 0;
    }

    top
    {
        type            zeroGradient;
    }

    step
    {
        type            zeroGradient;
    }

    floor
    {
        type            zeroGradient;
    }

    frontAndBack
    {
        type            empty;
    }
}

