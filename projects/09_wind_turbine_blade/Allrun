#!/bin/bash
#------------------------------------------------------------------------------
# Run the wind turbine MRF case (quasi-2D rotating zone in uniform flow).
#
#   1. blockMesh  - rectangular background mesh
#   2. topoSet    - cylindrical cellZone "rotatingZone" for the MRF region
#   3. checkMesh  - mesh quality check
#   4. simpleFoam - steady-state SIMPLE solver with MRF
#------------------------------------------------------------------------------
cd "${0%/*}" || exit 1
. "${WM_PROJECT_DIR:?}/bin/tools/RunFunctions"

runApplication blockMesh
runApplication topoSet
runApplication checkMesh
runApplication simpleFoam

echo "Done. Logs: log.blockMesh, log.topoSet, log.checkMesh, log.simpleFoam"
echo "View results with ./open_paraview.sh (or paraFoam inside an OpenFOAM shell)."
