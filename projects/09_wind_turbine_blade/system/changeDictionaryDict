FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      changeDictionaryDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// gmshToFoam makes every patch of type "patch"; set the real types.
boundary
{
    // The two sides of the sliding interface
    AMI_rotor
    {
        type            cyclicAMI;
        neighbourPatch  AMI_stator;
        transform       noOrdering;
        inGroups        (cyclicAMI);
    }

    AMI_stator
    {
        type            cyclicAMI;
        neighbourPatch  AMI_rotor;
        transform       noOrdering;
        inGroups        (cyclicAMI);
    }

    "blade.*"
    {
        type            wall;
    }

    // Tunnel sides far from the rotor (blockage 1/15)
    sides
    {
        type            symmetry;
    }

    frontAndBack
    {
        type            empty;
    }
}

