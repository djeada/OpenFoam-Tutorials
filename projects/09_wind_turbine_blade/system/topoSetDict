FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      topoSetDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Cylindrical cellZone "rotatingZone" used by constant/MRFProperties.
// Axis along z through (1.0, 0.5), radius 0.3 m, spanning the full domain depth.

actions
(
    // 1. Select cells whose centres lie inside the cylinder
    {
        name    rotatingZone;
        type    cellSet;
        action  new;
        source  cylinderToCell;
        sourceInfo
        {
            p1      (1.0 0.5 -1);   // cylinder start (outside domain)
            p2      (1.0 0.5  1);   // cylinder end   (outside domain)
            radius  0.3;
        }
    }

    // 2. Convert the cellSet to a cellZone (MRF refers to zones)
    {
        name    rotatingZone;
        type    cellZoneSet;
        action  new;
        source  setToCellZone;
        sourceInfo
        {
            set     rotatingZone;
        }
    }
);

