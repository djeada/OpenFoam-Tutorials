FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    "pcorr.*"
    {
        solver          GAMG;
        smoother        DICGaussSeidel;
        tolerance       1e-2;
        relTol          0;
        cacheAgglomeration no;
        maxIter         50;
    }

    p
    {
        solver          GAMG;
        smoother        DICGaussSeidel;
        tolerance       1e-6;
        relTol          0.01;
        cacheAgglomeration no;      // the AMI weights change as the rotor turns
    }

    pFinal
    {
        $p;
        relTol          0;
    }

    "(U|k|omega)"
    {
        solver          smoothSolver;
        smoother        symGaussSeidel;
        tolerance       1e-7;
        relTol          0.1;
    }

    "(U|k|omega)Final"
    {
        $U;
        relTol          0;
    }
}

// Two outer iterations per time step, each with two pressure corrections. The
// Courant number is below 1 in most of the rotor but reaches tens in the small
// wall cells at the sharp trailing edges; the extra iterations keep pressure
// and velocity coupled there.
PIMPLE
{
    correctPhi          no;     // solid-body rotation conserves cell volumes
    nOuterCorrectors    2;
    nCorrectors         2;
    nNonOrthogonalCorrectors 0;
}

relaxationFactors
{
    equations
    {
        ".*"            1;
    }
}

