FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      k;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -2 0 0 0 0];

// Inlet turbulence intensity I = 1 %: k = 1.5 (I U)^2 = 1.5 (0.08)^2
internalField   uniform 0.0096;

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           $internalField;
    }

    outlet
    {
        type            inletOutlet;
        inletValue      $internalField;
        value           $internalField;
    }

    // Zero gradient at the wall; k in the wall cell comes from its own equation.
    "blade.*"
    {
        type            kqRWallFunction;
        value           $internalField;
    }

    AMI_rotor
    {
        type            cyclicAMI;
        value           $internalField;
    }

    AMI_stator
    {
        type            cyclicAMI;
        value           $internalField;
    }

    sides
    {
        type            symmetry;
    }

    frontAndBack
    {
        type            empty;
    }
}

