FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      nut;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -1 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    inlet
    {
        type            calculated;
        value           uniform 0;
    }

    outlet
    {
        type            calculated;
        value           uniform 0;
    }

    // Spalding's law of the wall covers the viscous sublayer, the buffer layer
    // and the log layer in one formula, so the first cell can sit at any y+
    // (here a few units).
    "blade.*"
    {
        type            nutUSpaldingWallFunction;
        value           uniform 0;
    }

    AMI_rotor
    {
        type            cyclicAMI;
        value           $internalField;
    }

    AMI_stator
    {
        type            cyclicAMI;
        value           $internalField;
    }

    sides
    {
        type            symmetry;
    }

    frontAndBack
    {
        type            empty;
    }
}

