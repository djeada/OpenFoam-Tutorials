FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      epsilon;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Turbulent dissipation rate
// epsilon = Cmu^0.75 * k^1.5 / L
// Cmu = 0.09, k = 0.375 m^2/s^2
// L = 0.07 * D = 0.07 * 0.6 m = 0.042 m (D = MRF zone diameter)
// epsilon = 0.09^0.75 * 0.375^1.5 / 0.042 = 0.898 m^2/s^3

dimensions      [0 2 -3 0 0 0 0];

internalField   uniform 0.898;

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform 0.898;
    }

    outlet
    {
        type            zeroGradient;
    }

    topAndBottom
    {
        type            slip;
    }

    frontAndBack
    {
        type            empty;
    }
}

