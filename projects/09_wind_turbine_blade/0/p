FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      p;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -2 0 0 0 0];   // kinematic pressure p/rho

internalField   uniform 0;

boundaryField
{
    inlet
    {
        type            zeroGradient;
    }

    outlet
    {
        type            fixedValue;
        value           uniform 0;
    }

    "blade.*"
    {
        type            zeroGradient;
    }

    AMI_rotor
    {
        type            cyclicAMI;
        value           $internalField;
    }

    AMI_stator
    {
        type            cyclicAMI;
        value           $internalField;
    }

    sides
    {
        type            symmetry;
    }

    frontAndBack
    {
        type            empty;
    }
}

