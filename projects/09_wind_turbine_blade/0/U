FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 -1 0 0 0 0];

// Wind speed 8 m/s along +x
internalField   uniform (8 0 0);

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           $internalField;
    }

    outlet
    {
        type            inletOutlet;
        inletValue      uniform (0 0 0);
        value           $internalField;
    }

    // No-slip on a moving wall: the fluid at the blade surface moves with the
    // blade (the face velocity comes from the mesh motion).
    "blade.*"
    {
        type            movingWallVelocity;
        value           uniform (0 0 0);
    }

    AMI_rotor
    {
        type            cyclicAMI;
        value           $internalField;
    }

    AMI_stator
    {
        type            cyclicAMI;
        value           $internalField;
    }

    sides
    {
        type            symmetry;
    }

    frontAndBack
    {
        type            empty;
    }
}

