FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      omega;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 -1 0 0 0 0];

// Eddy viscosity 10 times the molecular viscosity: omega = k / (10 nu)
internalField   uniform 64;

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           $internalField;
    }

    outlet
    {
        type            inletOutlet;
        inletValue      $internalField;
        value           $internalField;
    }

    // Sets omega in the wall cell, blending the viscous-sublayer value
    // 6 nu / (beta1 y^2) and the log-layer value, so it works at any y+.
    "blade.*"
    {
        type            omegaWallFunction;
        value           $internalField;
    }

    AMI_rotor
    {
        type            cyclicAMI;
        value           $internalField;
    }

    AMI_stator
    {
        type            cyclicAMI;
        value           $internalField;
    }

    sides
    {
        type            symmetry;
    }

    frontAndBack
    {
        type            empty;
    }
}

