FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSolution;
}

// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    Phi
    {
        solver          GAMG;
        tolerance       1e-08;
        relTol          0.01;
        smoother        GaussSeidel;
    }

    p
    {
        solver          GAMG;
        tolerance       1e-08;
        relTol          0.01;
        smoother        GaussSeidel;
    }

    U
    {
        solver          smoothSolver;
        smoother        GaussSeidel;
        nSweeps         2;
        tolerance       1e-08;
        relTol          0.1;
    }

    nuTilda
    {
        solver          smoothSolver;
        smoother        GaussSeidel;
        nSweeps         2;
        tolerance       1e-08;
        relTol          0.1;
    }
}

SIMPLE
{
    nNonOrthogonalCorrectors 2;

    // No residualControl on purpose. With first-order upwind and this mesh
    // (y+ about 476, 62 degree non-orthogonality) the pressure residual plateaus
    // at about 1e-2 and never reaches a useful tolerance such as 1e-6, so such a
    // control would never trigger and only suggest that it does. The run always
    // ends at endTime; convergence is judged from the stationarity of Cl and Cd
    // in postProcessing/forceCoeffs (see verify.py).
}

potentialFlow
{
    nNonOrthogonalCorrectors 10;
}

relaxationFactors
{
    fields
    {
        p               0.2;
    }
    equations
    {
        U               0.3;
        nuTilda         0.2;
    }
}

