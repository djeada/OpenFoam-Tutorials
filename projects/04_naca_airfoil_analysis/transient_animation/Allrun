#!/bin/bash
set -eu

cd "${0%/*}" || exit 1
touch airfoil.foam

ensure_openfoam() {
    if [ -n "${WM_PROJECT_DIR:-}" ]; then
        return
    fi

    for bashrc in \
        /opt/openfoam*/etc/bashrc \
        /usr/lib/openfoam*/etc/bashrc \
        /usr/lib/openfoam/*/etc/bashrc \
        /usr/local/openfoam*/etc/bashrc \
        "$HOME"/OpenFOAM/*/etc/bashrc
    do
        if [ -f "$bashrc" ]; then
            # shellcheck disable=SC1090
            . "$bashrc"
            break
        fi
    done

    : "${WM_PROJECT_DIR:?OpenFOAM not found. Source it first, then rerun ./Allrun.}"
}

ensure_openfoam
. "$WM_PROJECT_DIR"/bin/tools/RunFunctions

MESH_MSH=constant/airfoil_animation.msh

echo "========================================"
echo "  NACA 0012 Transient Animation Case"
echo "========================================"

echo "Step 1: Generating geometry and Gmsh mesh..."
./make_mesh.sh

echo "Step 2: Importing Gmsh mesh into OpenFOAM..."
runApplication gmshToFoam "$MESH_MSH"

echo "Step 3: Setting patch types..."
runApplication changeDictionary

echo "Step 4: Renumbering mesh..."
runApplication renumberMesh -overwrite

echo "Step 5: Checking mesh quality..."
runApplication checkMesh

echo "Step 6: Decomposing for 4 MPI ranks..."
runApplication decomposePar

echo "Step 7: Running pimpleFoam in parallel..."
runParallel pimpleFoam

echo "Step 8: Reconstructing the written times..."
runApplication reconstructPar
rm -rf processor*

echo "========================================"
echo "  Transient animation case complete"
echo "========================================"
