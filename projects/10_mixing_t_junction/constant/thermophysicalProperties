FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      thermophysicalProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

thermoType
{
    type            heRhoThermo;
    mixture         pureMixture;
    transport       const;
    thermo          hConst;
    equationOfState Boussinesq;
    specie          specie;
    energy          sensibleEnthalpy;
}

mixture
{
    specie
    {
        molWeight   18.0;
    }

    equationOfState
    {
        rho0        990;        // kg/m^3, water near 325 K
        T0          325;        // K, reference temperature
        beta        4.5e-4;     // 1/K, thermal expansion coefficient
    }

    thermodynamics
    {
        Cp          4182;
        Hf          0;
    }

    transport
    {
        mu          1e-03;
        Pr          7.0;
    }
}

