#!/bin/bash
#------------------------------------------------------------------------------
# Mixing T-junction: blockMesh -> checkMesh -> buoyantSimpleFoam
# Requires a sourced OpenFOAM environment. Stops at the first failing step.
#------------------------------------------------------------------------------
cd "${0%/*}" || exit 1

run() {
    local app=$1
    echo "Running ${app} (log.${app})"
    if ! "${app}" > "log.${app}" 2>&1; then
        echo "ERROR: ${app} failed, see log.${app}" >&2
        exit 1
    fi
}

run blockMesh
run checkMesh
run buoyantSimpleFoam

echo "Done. Results are in the time directories; see log.buoyantSimpleFoam."
