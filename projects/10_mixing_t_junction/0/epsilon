FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      epsilon;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -3 0 0 0 0];

internalField   uniform 0.345;

boundaryField
{
    mainInlet
    {
        type            fixedValue;
        value           uniform 0.345;
    }

    branchInlet
    {
        type            fixedValue;
        value           uniform 0.0863;
    }

    outlet
    {
        type            zeroGradient;
    }

    walls
    {
        type            epsilonWallFunction;
        value           uniform 0.345;
    }

    frontAndBack
    {
        type            empty;
    }
}

