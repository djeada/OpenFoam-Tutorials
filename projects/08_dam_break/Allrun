#!/bin/bash
#------------------------------------------------------------------------------
# Allrun - dam break (interFoam)
#
#   1. Copy 0.orig to 0 (setFields modifies the copy, not the template)
#   2. blockMesh - generate the structured 2D mesh
#   3. checkMesh - mesh quality report
#   4. setFields - set alpha.water = 1 in the water column
#   5. interFoam - run the VOF solver
#------------------------------------------------------------------------------
cd "${0%/*}" || exit 1

. ${WM_PROJECT_DIR:?}/bin/tools/RunFunctions

rm -rf 0
cp -r 0.orig 0

runApplication blockMesh || exit 1
runApplication checkMesh || exit 1
runApplication setFields || exit 1
runApplication interFoam || exit 1

echo "Done. Logs: log.blockMesh, log.checkMesh, log.setFields, log.interFoam"
echo "Check results with: python3 verify.py;  view with: ./open_paraview.sh"
