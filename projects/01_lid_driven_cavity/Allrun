#!/bin/bash
cd "${0%/*}" || exit 1

# Source the OpenFOAM environment unless it is already loaded
if [ -z "${WM_PROJECT_DIR:-}" ]; then
    if [ -f /opt/openfoam6/etc/bashrc ]; then
        source /opt/openfoam6/etc/bashrc
    elif [ -f "$HOME/OpenFOAM/OpenFOAM-6/etc/bashrc" ]; then
        source "$HOME/OpenFOAM/OpenFOAM-6/etc/bashrc"
    else
        echo "Error: could not find the OpenFOAM 6 bashrc" >&2
        exit 1
    fi
fi

# Source run functions
. "$WM_PROJECT_DIR/bin/tools/RunFunctions"

set -e

runApplication blockMesh
runApplication checkMesh
runApplication icoFoam

echo "Case completed successfully (logs: log.blockMesh, log.checkMesh, log.icoFoam)."
