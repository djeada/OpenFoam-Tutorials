#!/bin/bash
# Allclean - remove generated files (mesh, time directories, logs, STL copy)
cd "${0%/*}" || exit
. "${WM_PROJECT_DIR:?}"/bin/tools/CleanFunctions

cleanCase
rm -f  constant/triSurface/boat_hull.stl
rm -rf constant/extendedFeatureEdgeMesh
rm -f  constant/triSurface/boat_hull.eMesh constant/triSurface/boat_hull.obj
rm -rf postProcessing processor*
rm -f  boat_hull_floating.foam 0/motionScale   # motionScale: written by the 6-DoF solver
rmdir  constant/triSurface 2>/dev/null
echo "Case cleaned."
